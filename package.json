{
  "name": "4j-finance",
  "version": "1.0.0",
  "private": true,
  "description": "4J Finance: aplicativo, paginas publicas e materiais de divulgacao",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node build.cjs",
    "test": "node scripts/check.cjs",
    "verify:build": "node scripts/verify-build.cjs",
    "test:ui": "node qa/public-pages.test.cjs && node qa/auth-responsive.test.cjs",
    "test:rules": "pnpm --dir privacy run test:rules"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
