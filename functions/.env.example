# Exemplo sem segredos. MP_ACCESS_TOKEN e MP_WEBHOOK_SECRET ficam no Secret Manager
# (ou .secret.local apenas no emulador), nunca neste arquivo, no chat ou no Git.
# Use IDs da conta e da aplicação do MESMO ambiente; teste e produção são distintos.
MP_COLLECTOR_ID=CONFIGURE_O_ID_NUMERICO_DO_RECEBEDOR
MP_APPLICATION_ID=CONFIGURE_O_ID_NUMERICO_DA_APLICACAO
MP_LIVE_MODE=false
# demo-4j-pix é somente o projeto local do emulador; não recebe deploy.
MP_TEST_FIREBASE_PROJECT_ID=demo-4j-pix
MP_PRODUCTION_FIREBASE_PROJECT_ID=financas-familia-9480b
PAYMENTS_ENABLED=false
# APP_USR também é prefixo de token de teste; não prova ambiente de produção.
# MP_WEBHOOK_URL não é parâmetro do backend e não vai no POST /v1/orders.
# Configure URL HTTPS e evento Order (Mercado Pago) diretamente no painel.
