rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function accountPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() { return signedIn() && exists(accountPath()) && get(accountPath()).data.status == 'approved'; }
    function platformAdmin() { return active() && get(accountPath()).data.role == 'admin'; }
    function verifiedEmail() { return signedIn() && request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') != ''; }
    function email() { return request.auth.token.email.lower(); }
    function owns(profile) { return signedIn() && profile.ownerUid == request.auth.uid; }
    function invited(profile, key) { return verifiedEmail() && email() in profile.get(key, []); }
    function canRead(profile) { return active() && (owns(profile) || invited(profile, 'sharedView') || invited(profile, 'sharedEdit')); }
    function canEdit(profile) { return active() && (owns(profile) || invited(profile, 'sharedEdit')); }
    function validName(value) { return value is string && value.size() > 0 && value.size() <= 80; }
    function validUser(data) {
      return data.keys().hasAll(['name','email','role','status','createdAt'])
        && data.keys().hasOnly(['name','email','role','status','createdAt','defaultProfileId'])
        && validName(data.name) && data.email is string
        && data.role in ['member','admin'] && data.status in ['approved','pending'];
    }
    function validShares(data) {
      return data.get('sharedView', []) is list && data.get('sharedEdit', []) is list
        && data.get('sharedView', []).size() <= 200 && data.get('sharedEdit', []).size() <= 200
        && !data.get('sharedView', []).hasAny(data.get('sharedEdit', []));
    }
    function validProfile(data) {
      return data.ownerUid is string && data.ownerUid.size() > 0
        && data.get('ownerEmail', '') is string && validShares(data)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60))
        && (!('kind' in data) || data.kind in ['personal','family'])
        && (!('goalsV2' in data) || (data.goalsV2 is list && data.goalsV2.size() <= 200))
        && (!('budgetPlan' in data) || data.budgetPlan is map)
        && (!('budgetMonths' in data) || data.budgetMonths is map)
        && (!('customCatReceita' in data) || (data.customCatReceita is list && data.customCatReceita.size() <= 200))
        && (!('customCatDespesa' in data) || (data.customCatDespesa is list && data.customCatDespesa.size() <= 200))
        && (!('customFormaPg' in data) || (data.customFormaPg is list && data.customFormaPg.size() <= 200));
    }
    function validRecord(data) {
      return data.keys().hasAll(['desc','valor','data'])
        && data.desc is string && data.desc.size() > 0 && data.desc.size() <= 2000
        && data.valor is number && data.valor >= 0 && data.valor <= 1000000000
        && data.data is string && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('parcelas' in data) || (data.parcelas is int && data.parcelas >= 1 && data.parcelas <= 600));
    }
    match /users/{uid} {
      // Own document can be read before it exists for create-only provisioning.
      allow get: if signedIn() && (request.auth.uid == uid || platformAdmin());
      allow list: if platformAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.email == email()
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'approved'
        && request.resource.data.createdAt == request.time;
      // A suspended account cannot reactivate itself or delete/recreate its record.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','defaultProfileId'])
          && validName(request.resource.data.name)
          && (!('defaultProfileId' in request.resource.data) || (request.resource.data.defaultProfileId is string && request.resource.data.defaultProfileId.size() <= 1500)))
        || (platformAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
          && request.resource.data.role in ['member','admin']
          && request.resource.data.status in ['approved','pending']
          && (request.resource.data.role != 'admin' || resource.data.role == 'admin' || request.resource.data.status == 'approved'))
      );
      allow delete: if false;
    }
    match /profiles/{profileId} {
      // There is deliberately NO platformAdmin exception for finances.
      allow get, list: if canRead(resource.data);
      allow create: if active() && validProfile(request.resource.data)
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','displayName','kind','sharedView','sharedEdit','createdAt','goalsV2','customCatReceita','customCatDespesa','customFormaPg','budgetPlan','budgetMonths','lastUpdatedAt','lastUpdatedBy'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == email()
        && request.resource.data.get('sharedView', []).size() == 0
        && request.resource.data.get('sharedEdit', []).size() == 0
        && request.resource.data.createdAt == request.time;
      allow update: if canEdit(resource.data) && validProfile(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '')
        && request.resource.data.get('kind', '') == resource.data.get('kind', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','sharedView','sharedEdit','goalsV2','customCatReceita','customCatDespesa','customFormaPg','budgetPlan','budgetMonths','lastUpdatedAt','lastUpdatedBy'])
        && (owns(resource.data) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goalsV2','customCatReceita','customCatDespesa','customFormaPg','budgetPlan','budgetMonths','lastUpdatedAt','lastUpdatedBy']));
      allow delete: if active() && owns(resource.data);
      match /{collection}/{recordId} {
        function profile() { return get(/databases/$(database)/documents/profiles/$(profileId)).data; }
        allow read: if collection in ['receitas','despesas'] && canRead(profile());
        allow create, update: if collection in ['receitas','despesas'] && canEdit(profile()) && validRecord(request.resource.data);
        allow delete: if collection in ['receitas','despesas'] && canEdit(profile());
      }
    }
    // Payment state is written/read only by trusted Admin SDK backend endpoints.
    match /billingOrders/{document=**} { allow read, write: if false; }
    match /billingAccounts/{document=**} { allow read, write: if false; }
    match /billingLocks/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
